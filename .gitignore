# Environment and Secrets (CRITICAL: NEVER COMMIT)
.env
*.env
*.env.*
backend/.env
frontend/.env
Vercel.txt
*.token

# Python / Backend
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
backend/storage/images/*
backend/storage/reports/*
backend/storage/audit/*
backend/storage/evidence/*
backend/storage/inspections/*
